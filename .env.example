# Copiá este archivo a .env (no se sube al repo) y completá los valores.
# En local no hace falta ninguno: usa SQLite (vaquita.db) y una clave aleatoria.

# Postgres de Neon, por ejemplo:
# DATABASE_URL=postgresql://usuario:clave@ep-xxxx.sa-east-1.aws.neon.tech/vaquita?sslmode=require
DATABASE_URL=sqlite:///vaquita.db

# Obligatoria en producción. Generala con: python -c "import secrets; print(secrets.token_urlsafe(48))"
VAQUITA_SECRET_KEY=

# "produccion" activa cookies Secure y HSTS.
VAQUITA_ENTORNO=desarrollo
